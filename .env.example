# =============================================================================
# TheBakerz — Environment Variables
# Copy this file to .env.local (development) or .env (Docker) and fill in
# real values. Never commit files containing actual secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Public base URL of the app / API (used by both server and client)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Server-side override of the API base URL (falls back to NEXT_PUBLIC_API_BASE_URL)
API_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL (primary database)
# -----------------------------------------------------------------------------
# Full connection string (takes precedence when set)
NEXT_PRIVATE_DATABASE_URL=postgresql://user:password@localhost:5432/thebakerz
# Individual connection parameters
NEXT_PRIVATE_DATABASE_HOST=localhost
NEXT_PRIVATE_DATABASE_USER=postgres
NEXT_PRIVATE_DATABASE_PASSWORD=your-database-password
NEXT_PRIVATE_DATABASE_NAME=thebakerz
DATABASE_DATABASE=thebakerz

# -----------------------------------------------------------------------------
# Azure Cosmos DB (document storage)
# -----------------------------------------------------------------------------
NEXT_PRIVATE_COSMOS_DB_URI=https://your-account.documents.azure.com:443/
NEXT_PRIVATE_COSMOS_DB_KEY=your-cosmos-db-primary-key
NEXT_PRIVATE_COSMOS_DB_NAME=thebakerz

# -----------------------------------------------------------------------------
# Azure Blob Storage (images / files)
# -----------------------------------------------------------------------------
NEXT_PRIVATE_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net
NEXT_PRIVATE_BLOB_AVATAR_CONTAINER=avatars
NEXT_PRIVATE_BLOB_BACKGROUND_CONTAINER=backgrounds
NEXT_PRIVATE_BLOB_PRODUCTS_CONTAINER=products

# -----------------------------------------------------------------------------
# Azure Communication Services (transactional email / OTP)
# -----------------------------------------------------------------------------
NEXT_PRIVATE_AZURE_COMMUNICATION_EMAIL_ENDPOINT=endpoint=https://your-resource.communication.azure.com/;accesskey=your-access-key
NEXT_PRIVATE_EMAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Stripe (payments)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
NEXT_PRIVATE_STRIPE_SECRET_KEY=your-stripe-secret-key

# -----------------------------------------------------------------------------
# Google (OAuth sign-in, Maps, address geo-validation)
# -----------------------------------------------------------------------------
NEXT_PRIVATE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NEXT_PRIVATE_GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PRIVATE_GOOGLE_GEO_VALIDATION=your-google-geo-validation-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# Azure Maps
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AZURE_MAPS_KEY=your-azure-maps-key

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Bearer token required by protected API routes
NEXT_PRIVATE_SECRET_BEARER=generate-a-long-random-string
SECRET_BEARER=generate-a-long-random-string
# Key used for encrypting sensitive data at rest
ENCRYPTION_KEY=generate-a-32-byte-random-key

# -----------------------------------------------------------------------------
# Redis (cache handler)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=thebakerz
# Set to "true" to log cache handler activity
NEXT_PRIVATE_DEBUG_CACHE=false
