-- Business addresses table
CREATE TABLE business_address (
    id       SERIAL PRIMARY KEY,
    route    TEXT NOT NULL,
    city     TEXT NOT NULL,
    country  TEXT NOT NULL,
    zip_code VARCHAR(20) NOT NULL
);

-- Business store table
CREATE TABLE business_store (
    id                  SERIAL PRIMARY KEY,
    store_id            VARCHAR(10) NOT NULL REFERENCES stores(id) ON DELETE CASCADE,
    name                TEXT NOT NULL,
    vat                 VARCHAR(50) NOT NULL,
    kvk                 VARCHAR(50) NOT NULL,
    bank_account        VARCHAR(100) NOT NULL,
    kor                 BOOLEAN NOT NULL,
    business_address_id INTEGER NOT NULL REFERENCES business_address(id) ON DELETE RESTRICT
);